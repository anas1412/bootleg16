[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]

linux.debug.x86_64 = "res://../target/debug/libgdbridge.so"
linux.release.x86_64 = "res://../target/release/libgdbridge.so"
windows.debug.x86_64 = "res://../target/debug/gdbridge.dll"
windows.release.x86_64 = "res://../target/release/gdbridge.dll"
