; bootleg16's Godot client. The Rust half (simulation, netcode) is the gdbridge
; GDExtension in ../gdbridge; build it before opening this project.
config_version=5

[application]

config/name="bootleg16"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/aspect="expand"
display_server/driver.linuxbsd="wayland"
; mailbox: no tearing, and frames aren't held back (plain vsync on NVIDIA + Wayland ran at ~47 fps)
window/vsync/vsync_mode=2

[rendering]

anti_aliasing/quality/msaa_3d=2
