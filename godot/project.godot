; bootleg16's Godot client. The Rust half (simulation, netcode) is the gdbridge
; GDExtension in ../gdbridge; build it before opening this project.
config_version=5

[application]

config/name="bootleg16"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scripts/settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
display_server/driver.linuxbsd="wayland"
; mailbox: no tearing, and frames aren't held back (plain vsync on NVIDIA + Wayland ran at ~47 fps)
window/vsync/vsync_mode=3

[rendering]

; SMAA: as smooth as 2x MSAA and cheaper here (benchmark: 190 vs 173 fps on the GTX 1650)
anti_aliasing/quality/screen_space_aa=2
