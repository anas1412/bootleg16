{
  "_about": "The one source of bootleg16's UI values. tools/make_design_system.py turns it into godot/ui/tokens.gd and the design system page. Change values here, nowhere else.",
  "grid": {
    "canvas": [1920, 1080],
    "margin_x": 96,
    "margin_y": 64,
    "columns": 12,
    "gutter": 24,
    "_note": "column = (1920 - 2*96 - 11*24) / 12 = 122; one column plus gutter = 146"
  },
  "space": { "xs": 4, "s": 8, "m": 16, "l": 24, "xl": 32, "xxl": 48, "huge": 64, "max": 96 },
  "stroke": { "hair": 2, "frame": 4, "mark": 8 },
  "color": {
    "bg":        { "hex": "#050608", "use": "The room. Every screen's ground." },
    "panel":     { "hex": "#0c0f13", "use": "A raised surface: squad rows, lists, popups." },
    "panel_hi":  { "hex": "#151a21", "use": "A surface under the pointer." },
    "line":      { "hex": "#252c35", "use": "Dividers and resting frames." },
    "text":      { "hex": "#f2f2f0", "use": "Main text and the marks." },
    "text_dim":  { "hex": "#8b9099", "use": "Secondary text, katakana under titles." },
    "text_off":  { "hex": "#545a63", "use": "Disabled and empty slots." },
    "you":       { "hex": "#ffa000", "use": "You and the main action: your name, DEPLOY, the selected tab. Never decoration." },
    "alert":     { "hex": "#ff3b3b", "use": "Live, danger, bomb planted. Only when something needs you now." },
    "bureau":    { "hex": "#49c6ff", "use": "The Bureau: their emblem, their players, their side of a score." },
    "strays":    { "hex": "#ff4f8b", "use": "The Strays: their emblem, their players, their side of a score." }
  },
  "font": {
    "display": { "file": "anton/Anton-Regular.ttf", "family": "Anton", "fallback": "Impact, 'Arial Narrow', sans-serif", "cap": 0.859 },
    "ui":      { "file": "barlow_condensed/BarlowCondensed-SemiBold.ttf", "family": "Barlow Condensed", "fallback": "'Arial Narrow', sans-serif", "cap": 0.7 },
    "ui_bold": { "file": "barlow_condensed/BarlowCondensed-Bold.ttf", "family": "Barlow Condensed", "fallback": "'Arial Narrow', sans-serif", "cap": 0.7 },
    "mono":    { "file": "ibm_plex_mono/IBMPlexMono-Medium.ttf", "family": "IBM Plex Mono", "fallback": "ui-monospace, monospace", "cap": 0.7 },
    "kana":    { "file": "noto_sans_jp/NotoSansJP[wght].ttf", "family": "Noto Sans JP", "fallback": "sans-serif", "wght": 500, "cap": 0.8 }
  },
  "type": {
    "takeover": { "font": "display", "size": 96, "line": 96,  "track": 0.01, "upper": true,  "use": "Full-screen moments: OPERATION READY, BOMB PLANTED." },
    "name":     { "font": "display", "size": 168, "line": 136, "track": 0,    "upper": true,  "use": "Your character's name card in the lobby." },
    "page":     { "font": "display", "size": 48, "line": 56,  "track": 0.01, "upper": true,  "use": "Page titles: LOCKER, SETTINGS." },
    "action":   { "font": "ui_bold", "size": 40, "line": 48,  "track": 0.06, "upper": true,  "use": "The main button: DEPLOY." },
    "tab":      { "font": "ui_bold", "size": 24, "line": 32,  "track": 0.12, "upper": true,  "use": "Top tabs and secondary buttons." },
    "body":     { "font": "ui",      "size": 24, "line": 32,  "track": 0,    "upper": false, "use": "Names in lists, settings rows, sentences." },
    "label":    { "font": "mono",    "size": 16, "line": 24,  "track": 0.14, "upper": true,  "use": "Small headers and readouts: YOUR SQUAD 2/5, ping, timers." },
    "kana":     { "font": "kana",    "size": 24, "line": 32,  "track": 0.3,  "upper": false, "use": "The katakana line under a name or title, in text_dim." },
    "tab_kana": { "font": "kana",    "size": 16, "line": 24,  "track": 0.3,  "upper": false, "use": "The katakana under a tab name." },
    "moment":   { "font": "display", "size": 128, "line": 128, "track": 0.01, "upper": true,  "use": "Over the game, the round's result: STRAYS WIN, MATCH POINT." },
    "alert":    { "font": "display", "size": 88, "line": 88,  "track": 0.01, "upper": true,  "use": "Over the game, what just changed everything: BOMB PLANTED, LAST ALIVE." },
    "hud_value": { "font": "ui_bold", "size": 52, "line": 52, "track": 0,    "upper": false, "use": "Health and ammo: the two numbers you check mid-fight." },
    "hud_timer": { "font": "mono",   "size": 34, "line": 44,  "track": 0,    "upper": false, "use": "The round timer and the bomb's fuse." },
    "hud_small": { "font": "mono",   "size": 20, "line": 28,  "track": 0,    "upper": false, "use": "Money, the reserve ammo." },
    "hud_name": { "font": "ui",      "size": 20, "line": 28,  "track": 0,    "upper": false, "use": "Names over the game: the kill feed, who's talking." },
    "hud_tag":  { "font": "mono",    "size": 12, "line": 16,  "track": 0.14, "upper": true,  "use": "Tags over the game: TEAM, NEAR, slot keys." }
  },
  "motion": {
    "hover_ms": 120,
    "enter_ms": 240,
    "exit_ms": 160,
    "takeover_ms": 400,
    "stagger_ms": 40,
    "slide": 16,
    "glitch_ms": 160,
    "glitch_split": 4,
    "glitch_tear": 10,
    "hurt_ms": 320,
    "hurt_split": 9,
    "hurt_tear": 26,
    "blur_behind": 16,
    "ease": [0.16, 1, 0.3, 1],
    "_note": "ease is expo-out (Godot: TRANS_EXPO, EASE_OUT). Glitch only on enter, hover start, state change and alerts; always settles clean. hurt_*: the same glitch, harder, when you're hit or low."
  }
}
